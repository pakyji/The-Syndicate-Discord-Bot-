{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_"
    }],
    "no-console": "off",

    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",

    "no-var": "error",
    "prefer-const": "warn",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-fallthrough": "error",
    "valid-typeof": "error",

    "require-atomic-updates": "off"
  },
  "overrides": [
    {
      "files": ["events/*.js", "index.js", "lib/guildStats.js"],
      "rules": {
        "require-atomic-updates": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "data/",
    "*.tmp",
    "*.corrupt-*.json"
  ]
}
