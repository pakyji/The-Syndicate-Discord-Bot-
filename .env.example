# ─────────────────────────────────────────────────────────────
# The Syndicate — environment configuration
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` (it is gitignored).
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here

# Register commands instantly in one server (recommended while developing).
# Leave blank to register globally — global rollout can take up to 1 hour.
GUILD_ID=

# ── Channel IDs ─────────────────────────────────────────────
# Defaults shown are the values that were previously hardcoded in source.
LOG_CHANNEL_ID=902047746624749588
WELCOME_CHANNEL_ID=901709300383227934
GOODBYE_CHANNEL_ID=901709744421629972
TRANSLATION_CHANNEL_ID=1538595475794563167
REPORT_CHANNEL_ID=1553912075494105139
HELPER_CHANNEL_ID=1536500109154451618
VERIFIED_PING_CHANNEL_ID=1552721386244407357
GREETING_CHANNEL_EN=1552721386244407357
GREETING_CHANNEL_IT=1537221793922940928
MAIN_LFG_CHANNEL_ID=1535656533919014932
ITALIAN_LFG_CHANNEL_ID=1537221793922940928
PC_CHANNEL_ID=1535658134230671370
PS4_CHANNEL_ID=901702088738865172
PS5_CHANNEL_ID=1550856575495839824
GIVEAWAY_CHANNEL_ID=1546252181920022538

# ── Role IDs ────────────────────────────────────────────────
# STRONGLY recommended: set these to role IDs. Without them the bot falls back
# to matching by role NAME, which lets anyone with Manage Roles create a decoy
# role called "Verified" and be treated as verified.
VERIFIED_ROLE_ID=
VERIFIED_ROLE_NAME=Verified
HELPER_ROLE_ID=
HELPER_ROLE_NAME=Helper

# ── Staff (comma-separated user IDs) receive report DMs ─────
STAFF_IDS=877175223504478218,906193555498885120,901459542976630865,1553477223003201576

# ── Auto-promotion (DISABLED by default) ────────────────────
# The original auto-granted the Helper role to a hardcoded user on every boot.
# That is a privilege-escalation path if the account is ever compromised.
# Use /promote instead, or set both values below to restore the old behaviour.
AUTO_HELPER_ENABLED=false
HELPER_MEMBER_ID=1382654025329021078

# ── Moderation defaults ─────────────────────────────────────
ANTILINK_DEFAULT=true
ANTIBADWORDS_DEFAULT=true
ANTISPAM_DEFAULT=true
BLOCKED_LINKS=discord.gg,t.me
BAD_WORDS=
SPAM_LIMIT=5
SPAM_WINDOW_MS=5000
SPAM_TIMEOUT_MS=60000
DUPLICATE_LIMIT=3

# ── Economy ─────────────────────────────────────────────────
COIN_MIN_EARN=5
COIN_MAX_EARN=15
COIN_COOLDOWN_MS=60000
COIN_REQUIRE_VERIFIED=true

# ── Levels ──────────────────────────────────────────────────
XP_PER_MESSAGE=15
XP_COOLDOWN_MS=60000
XP_PER_LEVEL_MULTIPLIER=100
ANNOUNCE_LEVEL_UPS=true

# ── Translation ─────────────────────────────────────────────
TRANSLATION_ENABLED=true
TRANSLATION_TARGET_LANG=en
TRANSLATION_TIMEOUT_MS=5000
TRANSLATION_MAX_LENGTH=500
# The original deleted the author's own message after posting the translation.
# That is destructive (loses edit history, replies, reactions), so it is off now.
TRANSLATION_DELETE_ORIGINAL=false

# ── Media link embeds (DISABLED by default) ─────────────────
# The original deleted a member's own message whenever it contained a
# Spotify/TikTok/YouTube link, in every channel. That is destructive, so it is
# off. Enable it and restrict it to specific channels if you want it.
MEDIA_EMBED_ENABLED=false
MEDIA_EMBED_CHANNELS=
MEDIA_EMBED_DELETE_ORIGINAL=false

# ── Verified ping task ──────────────────────────────────────
VERIFIED_PING_ENABLED=true
VERIFIED_PING_INTERVAL_MS=1800000
VERIFIED_PING_COOLDOWN_MS=10800000
BOT_TIMEZONE=Europe/Rome
VERIFIED_PING_FROM_HOUR=6
VERIFIED_PING_TO_HOUR=23
VERIFIED_PING_MAX=50

# ── Twitch live alerts (optional) ───────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_POLL_MS=60000

# ── Presence ────────────────────────────────────────────────
BOT_STATUSES=Visual Studio Code,Ubuntu/Linux,The Syndicate - Community Bot
STATUS_ROTATE_MS=1800000

# ── Storage ─────────────────────────────────────────────────
# Where data/store.json lives. Defaults to ./data inside the project.
# DATA_DIR=./data

# ── Identity (optional) ─────────────────────────────────────
# CLIENT_ID is only needed if you want to register commands without the bot
# being online; otherwise it is read from the logged-in client.
# CLIENT_ID=

# ── Music (/music — YouTube via play-dl + @discordjs/voice) ──
# Set MUSIC_ENABLED=false to hide every /music subcommand and skip loading the
# player entirely — do this on a host where the opus encoder cannot be built.
MUSIC_ENABLED=true
# Playback volume, 0-200 (100 is the source volume).
MUSIC_DEFAULT_VOLUME=80
# Hard ceilings. An unbounded queue is a memory leak and an unbounded track is a
# 10-hour loop video that locks the bot for a day.
MUSIC_MAX_QUEUE=200
MUSIC_MAX_TRACK_MINUTES=90
MUSIC_MAX_PLAYLIST_ITEMS=50
# Leave the voice channel when nobody is listening / the queue has drained.
MUSIC_IDLE_DISCONNECT_MINUTES=5
MUSIC_EMPTY_QUEUE_MINUTES=2
# Per-member throttle on queueing, so one person cannot flood the queue.
MUSIC_PLAY_COOLDOWN_MS=3000
MUSIC_SEARCH_TIMEOUT_MS=15000
# Comma-separated voice channel IDs the bot must never join.
MUSIC_BLOCKED_CHANNELS=

# ── Update announcement ("🟢 The Syndicate is LIVE") ─────────
# Fires when the version in package.json DIFFERS from the last announced one,
# which is persisted in data/store.json. An ordinary restart stays silent, so a
# crash-loop cannot spam the server with @everyone pings.
#
#   To ship an update:  add a CHANGELOG.md section, bump package.json version,
#                       deploy, restart. That is the whole trigger.
ANNOUNCE_ENABLED=true
ANNOUNCE_PING_EVERYONE=false
# Where to post. Falls back to the server's system channel, then the first text
# channel, if this ID is unusable. Defaults to HELPER_CHANNEL_ID when unset.
ANNOUNCE_CHANNEL_ID=
# How many changelog bullets to quote in the message.
ANNOUNCE_CHANGELOG_ITEMS=8
# Safety net for a redeploy loop: most announcements allowed per rolling hour.
# When the cap is hit the version is NOT recorded, so it still goes out later.
ANNOUNCE_MAX_PER_HOUR=3
# Never re-announce a version that already went out (protects against rollbacks).
ANNOUNCE_ONCE_PER_VERSION=true
# The very first boot has no stored version. true = announce it (that is the
# "I just deployed it" case); false = record the version silently instead.
ANNOUNCE_ON_FIRST_BOOT=true

# ---------------------------------------------------------------------------
# Developer portal prerequisites (not env vars — these are toggles in
# https://discord.com/developers/applications -> your app -> Bot)
#
#   Privileged Gateway Intents:
#     [x] SERVER MEMBERS INTENT     verification, role checks, member lists
#     [x] MESSAGE CONTENT INTENT    moderation, anti-spam, XP
#     [x] MESSAGE REACTION INTENT   the /poll reaction guard
#                                   (events/pollReactions.js)
#
#   Bot permissions the music feature additionally needs in voice channels:
#     CONNECT, SPEAK  (and VIEW_CHANNEL). /music refuses to join when any is
#     missing and tells the user exactly which one, rather than sitting silent.
#
#   The bot requests all three in index.js. If any is left off, Discord rejects
#   the gateway session with UsedDisallowedIntents and the bot exits.
# ---------------------------------------------------------------------------
